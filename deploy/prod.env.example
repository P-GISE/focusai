# /data1/docker/focusai/.env 의 템플릿입니다.
# 실제 운영 적용 시 이 파일을 .env로 복사한 뒤 CHANGE_ME 값을 실제 비밀값으로 채우세요.
# 주의: .env 파일은 절대 git에 커밋하지 마세요.

NODE_ENV=production
PORT=8787

# Cloudflared 터널이 HTTPS 종단 → Traefik(:80) → 컨테이너(:8787) 로 들어옵니다.
# CLIENT_ORIGIN/APP_BASE_URL 은 외부에서 보이는 도메인 그대로 사용합니다.
CLIENT_ORIGIN=https://focusai.ibetter.kr
APP_BASE_URL=https://focusai.ibetter.kr

# MariaDB
# 이 컨테이너는 docker network 'web'에 붙고, mariadb-11.4.5 컨테이너도 같은 web 네트워크에 있으므로
# 컨테이너 이름으로 직접 DNS 해석됩니다. (호스트 IP 또는 host.docker.internal 불필요)
#
# focusai_app 계정에 DDL 권한도 함께 부여하므로 (DEPLOYMENT.md 사전준비 3번 참조)
# AUTO_MIGRATE_SCHEMA=true 상태에서 첫 부팅 시 자동으로 14개 테이블이 생성되고,
# 향후 코드에 신규 컬럼이 추가되어도 ensureColumn 마이그레이션이 자동 적용됩니다.
MARIADB_HOST=mariadb-11.4.5
MARIADB_PORT=3306
MARIADB_USER=focusai_app
MARIADB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MARIADB_DATABASE=focusai
MARIADB_CONNECTION_LIMIT=10
AUTO_MIGRATE_SCHEMA=true
ALLOW_ROOT_DB_IN_PRODUCTION=false
FOCUSAI_DISABLE_DISCORD_BOT_AUTOSTART=false

# 세션 / 관리자
SESSION_COOKIE_NAME=focusai_session
SESSION_TTL_DAYS=30
ADMIN_EMAILS=admin@example.com

# Rate limit
AUTH_RATE_LIMIT_WINDOW_MS=600000
AUTH_RATE_LIMIT_MAX=10
ACCOUNT_RATE_LIMIT_WINDOW_MS=600000
ACCOUNT_RATE_LIMIT_MAX=10
AI_RATE_LIMIT_WINDOW_MS=900000
AI_RATE_LIMIT_MAX=20
ADMIN_RATE_LIMIT_WINDOW_MS=900000
ADMIN_RATE_LIMIT_MAX=60

# Anthropic (AI 피드백)
# 키가 비어 있으면 자동으로 로컬 휴리스틱으로 fallback 됩니다.
ANTHROPIC_API_KEY=CHANGE_ME_ANTHROPIC_API_KEY
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_MAX_TOKENS=900
ANTHROPIC_TIMEOUT_MS=20000
ANTHROPIC_DAILY_REQUEST_LIMIT=20
ANTHROPIC_DAILY_BUDGET_USD=1.0
ANTHROPIC_INPUT_USD_PER_MILLION=3
ANTHROPIC_OUTPUT_USD_PER_MILLION=15
ANTHROPIC_CACHE_WRITE_USD_PER_MILLION=3.75
ANTHROPIC_CACHE_READ_USD_PER_MILLION=0.30

# 비밀번호 재설정 메일 (SMTP 비어 있으면 /api/auth/forgot-password 가 503 반환)
PASSWORD_RESET_TTL_MINUTES=30
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=example@example.com
SMTP_PASSWORD=CHANGE_ME_APP_PASSWORD
SMTP_FROM=FocusAI <example@example.com>

# FocusAI Discord 관리자 봇
# DISCORD_BOT_SETTINGS_SECRET은 운영에서 고정값으로 설정하면 저장된 봇 토큰 복호화 키가 재시작 후에도 유지됩니다.
DISCORD_BOT_SETTINGS_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL
DISCORD_BOT_TOKEN=CHANGE_ME_DISCORD_BOT_TOKEN
DISCORD_CLIENT_ID=CHANGE_ME_DISCORD_CLIENT_ID
DISCORD_GUILD_ID=CHANGE_ME_DISCORD_GUILD_ID
DISCORD_ADMIN_CHANNEL_ID=CHANGE_ME_DISCORD_ADMIN_CHANNEL_ID
DISCORD_ADMIN_ROLE_IDS=CHANGE_ME_DISCORD_ADMIN_ROLE_IDS
DISCORD_BOT_ACTOR_USER_ID=CHANGE_ME_ADMIN_USER_ID
DISCORD_REGISTER_COMMANDS=true
DISCORD_ADMIN_URL=https://focusai.ibetter.kr/admin
DISCORD_SUPPORT_POLL_MS=30000
DISCORD_HEALTH_POLL_MS=60000
DISCORD_DAILY_SUMMARY_HOUR=9

# Lost Ark Discord 봇
# 비워두면 운영 번들에서 uploads/lostark-discord-bot 경로를 사용합니다.
LOSTARK_DISCORD_BOT_DIR=
