{
  "name": "focusai-webapp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-web.mjs",
    "dev:client": "node scripts/dev-client.mjs",
    "dev:server": "tsx server/src/index.ts",
    "dev:bot": "tsx bot/src/index.ts",
    "dev:web": "node scripts/dev-web.mjs",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "npm run build:client && npm run build:server && npm run build:bot && npm run build:lostark-bot",
    "build:client": "tsc -b && node scripts/build-client.mjs",
    "build:android:web": "node scripts/build-android-client.mjs",
    "build:server": "node scripts/build-ts-project.mjs server/tsconfig.json server/dist",
    "build:bot": "node scripts/build-ts-project.mjs tsconfig.bot.json bot/dist",
    "build:lostark-bot": "node scripts/build-lostark-discord-bot.mjs",
    "android:sync": "npm run build:android:web && cap sync android",
    "android:apk": "npm run android:sync && cd android && gradlew assembleDebug",
    "android:aab": "npm run android:sync && cd android && gradlew bundleRelease",
    "android:open": "npm run android:sync && cap open android",
    "db:init": "tsx server/src/init-db.ts",
    "lint": "eslint .",
    "test:bot": "node --import tsx --test bot/src/*.test.ts",
    "preview": "node scripts/preview-client.mjs",
    "start": "node server/dist/index.js",
    "start:bot": "node bot/dist/bot/src/index.js",
    "test": "npm run test:server && npm run test:bot && npm run test:docs",
    "test:server": "node --import tsx --test server/src/*.test.ts",
    "test:docs": "node --import tsx --test docs/*.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@discordjs/voice": "^0.19.2",
    "@emnapi/core": "^1.10.0",
    "@emnapi/runtime": "^1.10.0",
    "@mediapipe/tasks-vision": "^0.10.35",
    "cors": "^2.8.6",
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ffmpeg-static": "^5.3.0",
    "google-tts-api": "^2.0.2",
    "html2pdf.js": "^0.14.0",
    "mariadb": "^3.5.2",
    "nodemailer": "^9.0.3",
    "opusscript": "^0.0.8",
    "prism-media": "^1.3.5",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "zod": "^4.4.2"
  },
  "overrides": {
    "axios": "^1.16.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.4",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.12.2",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "rollup": "npm:@rollup/wasm-node@^4.60.2",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^6.4.1"
  },
  "description": "FocusAI의 실제 배포형 웹 MVP입니다.   브라우저 기반 학습 세션, 리포트, AI 피드백, 공지사항, 문의/신고, 관리자 페이지를 `React + Express + MariaDB` 구조로 구성했습니다.",
  "main": "eslint.config.js",
  "repository": {
    "type": "git",
    "url": "https://gitlab.ibetter.kr/focusai/focusai.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
